# ==========================================
# Étape 1 : Dépendances PHP (Composer)
# ==========================================
FROM composer:latest AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-interaction --no-dev --no-scripts --no-autoloader --ignore-platform-reqs

# ==========================================
# Étape 2 : Compilation des Assets (Node)
# ==========================================
FROM node:20-alpine AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install
COPY . .
RUN npm run production || true

# ==========================================
# Étape 3 : Runtime Final (PHP-FPM)
# ==========================================
FROM php:8.2-fpm-alpine

# Installation des dépendances système essentielles uniquement
RUN apk add --no-cache \
    postgresql-dev \
    supervisor \
    libzip-dev \
    zip \
    unzip

RUN docker-php-ext-install pdo_pgsql pgsql zip

# Configuration PHP & Supervisor
COPY docker/php/php.ini /usr/local/etc/php/conf.d/app.ini
COPY docker/supervisor/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

WORKDIR /var/www/html

# Copie du code source avec les bonnes permissions
COPY --chown=www-data:www-data . .

# Récupération des dépendances depuis les étapes précédentes
COPY --from=vendor --chown=www-data:www-data /app/vendor/ ./vendor/
COPY --from=frontend --chown=www-data:www-data /app/public/js/ ./public/js/
COPY --from=frontend --chown=www-data:www-data /app/public/css/ ./public/css/
COPY --from=frontend --chown=www-data:www-data /app/public/mix-manifest.json ./public/mix-manifest.json

# Finalisation de l'autoloader Composer
RUN composer dump-autoload --optimize --no-dev --classmap-authoritative

# Optimisation Laravel (doit être fait après la copie du code)
# Note: Vérifiez que les variables d'environnement nécessaires sont présentes ou utilisez des valeurs par défaut
RUN php artisan config:cache || true && \
    php artisan route:cache || true && \
    php artisan view:cache || true

# Ajustement final des permissions pour storage et cache
RUN chmod -R 775 storage bootstrap/cache

EXPOSE 9000

CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
