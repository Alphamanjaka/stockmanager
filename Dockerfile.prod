FROM php:8.2-fpm-alpine

# Installation des dépendances
RUN apk add --no-cache \
    postgresql-dev \
    nginx \
    supervisor \
    curl \
    libzip-dev \
    zip \
    unzip \
    git \
    nodejs \
    npm \
    bash

# Installation des extensions PHP
RUN docker-php-ext-install pdo_pgsql pgsql zip

# Installation de Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Configuration PHP
COPY docker/php/php.ini /usr/local/etc/php/conf.d/app.ini

# Configuration Supervisor
COPY docker/supervisor/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Création des dossiers pour les logs
RUN mkdir -p /var/log/supervisor && \
    mkdir -p /var/log/nginx && \
    touch /var/log/supervisor/supervisord.log

# Work directory
WORKDIR /var/www/html

# Copie des fichiers de l'application
COPY . .

# Installation des dépendances PHP (sans dev)
RUN composer install --no-interaction --optimize-autoloader --no-dev

# Installation des assets (si nécessaire)
RUN if [ -f "package.json" ]; then \
    npm install && npm run production || true; \
    fi

# Cache Laravel
RUN php artisan config:cache && \
    php artisan route:cache && \
    php artisan view:cache

# Permissions
RUN chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache && \
    chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache && \
    chown -R www-data:www-data /var/log/supervisor

# Script de démarrage personnalisé
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 80 443 9000

ENTRYPOINT ["entrypoint.sh"]
