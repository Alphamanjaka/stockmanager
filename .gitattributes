* text=auto eol=lf
# Scripts Windows : cmd.exe lit mal les fins de ligne LF (blocs entre parenthèses, étiquettes)
*.bat text eol=crlf
*.cmd text eol=crlf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
