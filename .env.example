APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker : DB_HOST=postgres / Laragon : DB_HOST=127.0.0.1
# Haute disponibilité (pg_auto_failover) : DB_HOST peut lister plusieurs nœuds séparés par
# des virgules ; l'application se connecte automatiquement au nœud primaire (voir docs/ha-postgresql.md).
#   ex. DB_HOST=pg-node1,pg-node2
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=laravel
DB_PASSWORD=

# Bascule automatique : ne retenir qu'une connexion en lecture-écriture (nœud primaire).
# Laisser vide pour une base unique ; mettre "read-write" en production HA.
# DB_TARGET_SESSION_ATTRS=read-write
# Délai (secondes) avant d'abandonner un hôte injoignable et d'essayer le suivant.
# DB_CONNECT_TIMEOUT=5

# Dossier contenant pg_dump (sauvegardes). Laragon : "C:\\laragon\\bin\\postgresql\\postgresql\\bin"
# PGDUMP_PATH=/usr/bin/

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Docker (développement) : synchronise l'UID/GID pour éviter les problèmes de permissions
UID=1000
GID=1000
