# Liste blanche : seul ce dont les images ont besoin entre dans le contexte de build. Le reste du poste (.env et
# .env.*, storage avec ses sauvegardes et fichiers temporaires, vendor, node_modules…) n'atteint jamais une image.
*
!app
!bootstrap
!config
!database
!docker
!lang
!public
!resources
!routes
!artisan
!composer.json
!composer.lock
!package.json
!package-lock.json
!vite.config.js
# Lu par Tailwind pour savoir quels fichiers ne pas analyser
!.gitignore

# Produits sur le poste, régénérés dans les images
bootstrap/cache/*.php
public/build
public/storage
# Présent tant que « npm run dev » tourne : copié dans une image, il ferait charger les assets depuis Vite
public/hot
# Seul index.php est exécuté (voir docker/nginx.conf)
public/**/*.php
!public/index.php
